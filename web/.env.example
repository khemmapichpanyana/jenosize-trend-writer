# Jenosize AI Content console — copy to .env.local (never commit it).

# The studio/jobs API deployed on Modal (printed by `make deploy-modal` in
# ai-services), or http://localhost:8001 for `make jobs-dev`.
STUDIO_API_URL=https://<workspace>--jenosize-trend-writer-jobs-api.modal.run
# Same value as JOBS_API_KEY in ai-services. Server-side only: the browser never
# sees it; every call goes through /api/studio/* on this app.
STUDIO_API_KEY=

# One shared login for the whole console (HTTP Basic auth, see proxy.ts).
# Required in production; unset in dev means no login. /p/* pages stay public.
CONSOLE_USER=jenosize
CONSOLE_PASSWORD=

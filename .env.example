# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
#
# Precedence: this file beats variables exported in your shell, on purpose —
# a global `export R2_BUCKET=...` for another project must not redirect this
# one's writes. Deployments (Vercel/Modal) have no .env, so real env vars apply.
#
# The defaults below run the article API locally with zero cloud accounts.
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
PORT=8777                      # local API port; defaults to 8777 when omitted
PUBLIC_BASE_URL=http://localhost:8777 # update this too if you change PORT
CORS_ALLOW_ORIGINS=http://localhost:8777,https://trend-writer.workser.app
API_KEY=                      # optional: if set, require X-API-Key on POST routes

# --- model -------------------------------------------------------------------
MODEL_PROVIDER=mock           # mock | openai_compatible
MODEL_BASE_URL=               # the vLLM URL printed by `make deploy-modal`, + /v1
MODEL_API_KEY=                # = VLLM_API_KEY
MODEL_NAME=jeno-lora          # base model name also allowed for eval
MODEL_TIMEOUT_S=240
MODEL_RETRY_ATTEMPTS=5         # includes the first request; retries transient 502/503/504
MODEL_RETRY_INITIAL_S=10       # exponential backoff for a serverless cold start
MODEL_RETRY_MAX_S=60

# --- Supabase ----------------------------------------------------------------
PERSISTENCE=none              # none | supabase   (article API)
SUPABASE_URL=                 # https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=          # sb_secret_…  server-side only, bypasses RLS
# Postgres for the data pipeline. Either set DB_URL to a full connection string,
# or let it be built from SUPABASE_URL + DB_PASSWORD + DB_HOST.
DB_URL=                       # postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DB_PASSWORD=                  # Dashboard -> Project Settings -> Database
DB_HOST=                      # the *session pooler* host, e.g. aws-0-<region>.pooler.supabase.com
                              # (the direct db.<ref>.supabase.co is IPv6-only; Modal needs IPv4)
# DATABASE_URL is accepted as a synonym for DB_URL.
# Not used by this server (no browser client, no user auth); fine to keep:
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# --- Cloudflare R2 -----------------------------------------------------------
STORAGE=local                 # local | r2   (article API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_ENDPOINT=              # https://<account-id>.r2.cloudflarestorage.com  (bucket page -> S3 API)
R2_JENOSIZE_BUCKET=           # e.g. jenosize-ai-content
# Not used by the code (S3 API uses the keys above). Keep public access OFF:
# the bucket holds scraped third-party articles and user uploads.
R2_ACCOUNT_API_TOKEN=
R2_PUBLIC_URL=

# --- jobs API + Modal (`make modal-secrets` copies what each needs) ------------
JOBS_API_KEY=                 # openssl rand -hex 24
VLLM_API_KEY=                 # openssl rand -hex 24  (bearer token for the vLLM server)

# --- studio agent (studio/; served with the jobs API) -------------------------
# Orchestrating model on the Modal vLLM server (MODEL_BASE_URL); the article text
# always comes from the fine-tuned MODEL_NAME via write_article.
AGENT_MODEL=Qwen/Qwen3-4B-Instruct-2507
AGENT_PROVIDER=auto           # auto | mock (deterministic, no GPU or LLM account)
OPENAI_API_KEY=               # server-side key for the Studio generate_image tool
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium
TAVILY_API_KEY=                # server-side key for the Studio web_search tool (tavily.com); unset = tool reports itself unavailable
# Fallback when the GPU is cold/down; defaults to the LABELER_* model if unset.
AGENT_FALLBACK_BASE_URL=
AGENT_FALLBACK_API_KEY=
AGENT_FALLBACK_MODEL=
# Public base for shared pages, e.g. the console's URL (it proxies /p/*).
PUBLIC_SHARE_BASE_URL=

# --- reverse-labelling (any OpenAI-compatible LLM) ----------------------------
LABELER_BASE_URL=
LABELER_API_KEY=
LABELER_MODEL=

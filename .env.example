# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# The defaults below run the whole service locally with zero cloud accounts.
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:8000,https://trend-writer.workser.app
API_KEY=                      # optional: if set, require X-API-Key on POST routes

MODEL_PROVIDER=mock           # mock | openai_compatible
MODEL_BASE_URL=               # https://<workspace>--jenosize-trend-writer-serve.modal.run/v1
MODEL_API_KEY=
MODEL_NAME=jeno-lora          # base model name also allowed for eval
MODEL_TIMEOUT_S=240

PERSISTENCE=none              # none | supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=          # server-side only, never exposed to the browser

# Data pipeline (scrape -> clean -> label -> build) writes straight to Postgres.
# Supabase: Dashboard -> Connect -> "Session pooler" URI (IPv4-friendly, port 5432).
DATABASE_URL=                 # postgresql://user:pass@host:5432/postgres

STORAGE=local                 # local | r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jenosize-trend-writer
R2_ENDPOINT=                  # optional override (MinIO/tests); derived from R2_ACCOUNT_ID if empty

LABELER_BASE_URL=             # any OpenAI-compatible LLM for reverse-labeling
LABELER_API_KEY=
LABELER_MODEL=
